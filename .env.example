# Copy to .env before `docker compose up`:  cp .env.example .env
#
# Passkeys are bound to the exact hostname the browser sees, so RP_ID and ORIGIN
# must match your address bar exactly or sign-in fails verification.

# Host port the app is served on.
WEB_PORT=8080

# Passkey relying party. For local use leave these as-is.
# Behind a domain, e.g.:  RP_ID=gym.example.com  ORIGIN=https://gym.example.com
RP_ID=localhost
ORIGIN=http://localhost:8080
RP_NAME=openGym

# How long a session stays signed in, in days.
SESSION_DAYS=90

# --- optional: locking the instance down ---------------------------------
# Comma-separated user ids that get the admin dashboard. Register your passkey
# first, then read your id from ./data/db.json under users[].id.
# ADMIN_UIDS=

# Require an invite code for new profiles. Existing accounts keep working.
# INVITE_ONLY=0

# Contact address embedded in push notifications. Defaults to ORIGIN over HTTPS.
# VAPID_SUBJECT=mailto:admin@example.com
